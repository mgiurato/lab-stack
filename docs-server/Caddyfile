{
	auto_https off
	admin off
}

# Read-only markdown served for documentation-stack's docs.lan viewer. Its Caddy
# reverse-proxies /peer-docs/lab-stack/* here server-side, so the browser never fetches
# from this port; the wildcard CORS header is left over from when it did, and nothing
# relies on it any more. Nothing secret is mounted into /srv (see the docs-server volume list in compose.yml), and
# docs/audits/ is deliberately not among the mounts.
:8092 {
	root * /srv
	header Access-Control-Allow-Origin "*"
	header Cache-Control "no-cache"
	file_server browse
}
