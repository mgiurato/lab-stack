# =========================
# General
# =========================

TZ=Europe/Rome


# =========================
# LAN
# =========================

# This host's own address: the lab's own LXC (CT 104 on pve-01).
LAB_HOST=192.168.1.50
LAN_SUBNET=192.168.1.0/24


# =========================
# Peer stacks
# =========================

# LAN addresses of the stacks this one talks to. Nothing here talks to another stack
# by Docker container name -- that only works while stacks share a host, which is
# exactly the coupling the split into separate repos removes. Moving a stack is a
# one-line change here.
#
# The lab is a leaf: it is scraped by monitoring-stack and reverse-proxied by
# network-stack, and it initiates nothing towards either except Alloy's log push.
# It must never be granted an entry in another stack's PEER_HOSTS.
NETWORK_HOST=192.168.1.39
MONITORING_HOST=192.168.1.39

# The plaintext of monitoring-stack's LOKI_PUSH_AUTH_HASH: Alloy pushes its logs to Loki
# through loki-proxy's basic auth with it. One credential for every log-shipping stack --
# copy it from network-stack's .env.
LOKI_PUSH_PASSWORD=


# =========================
# Workloads
# =========================

# Secrets are required: Compose refuses to start a service without its own. Generate
# each with `openssl rand -hex 24`. The database and Redis passwords go into
# connection URLs, so keep them to letters and digits.

# SearXNG signs its cookies and links with this.
SEARXNG_SECRET=

# SnapOtter's admin login (user `admin`). This only seeds the account: it forces a
# new password at the first sign-in.
SNAPOTTER_PASSWORD=

# SnapOtter's PostgreSQL owner role, the one the app connects as.
POSTGRES_PASSWORD=

# SnapOtter's Redis.
REDIS_PASSWORD=
