# =========================
# General
# =========================

TZ=Europe/Rome


# =========================
# LAN
# =========================

# This host's own address. Set it when the lab gets its own LXC -- the placeholder
# below is not a real host.
LAB_HOST=192.168.1.40
LAN_SUBNET=192.168.1.0/24


# =========================
# Peer stacks
# =========================

# LAN addresses of the stacks this one talks to. Nothing here talks to another stack
# by Docker container name -- that only works while stacks share a host, which is
# exactly the coupling the split into separate repos removes. Moving a stack is a
# one-line change here.
#
# The lab is a leaf: it is scraped by monitoring-stack and reverse-proxied by
# network-stack, and it initiates nothing towards either except Alloy's log push.
# It must never be granted an entry in another stack's PEER_HOSTS.
NETWORK_HOST=192.168.1.39
MONITORING_HOST=192.168.1.39


# =========================
# Workloads
# =========================

# Stirling PDF's initial admin login. Change it in the UI after first start; this only
# seeds the account. Required -- without it the workload starts with no login.
STIRLING_USERNAME=admin
STIRLING_PASSWORD=
